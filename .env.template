# HealthAI Assistant Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/healthai_db

# Security Secrets (Generate new ones using: node generate-secrets.js)
SESSION_SECRET=your_secure_session_secret_here
JWT_SECRET=your_secure_jwt_secret_here
ENCRYPTION_KEY=your_secure_encryption_key_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here

# Communication Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Microsoft Teams Integration (Optional)
TEAMS_ACCESS_TOKEN=your_teams_access_token

# Application Configuration
NODE_ENV=development
PORT=5000
TRUST_PROXY=true

# Security Configuration (Set to true in production)
SECURE_COOKIES=false
HTTPS_ONLY=false
ENFORCE_HTTPS=false

# Google Cloud Configuration (Optional)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Rate Limiting (requests per time window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
MEDICAL_RATE_LIMIT_MAX=50
CHAT_RATE_LIMIT_MAX=30

# Session Configuration
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_LEVEL=info

# Development Settings (Set to false in production)
ENABLE_DEV_TOOLS=true
ALLOW_INSECURE_HTTP=true
DISABLE_CSRF_PROTECTION=true
