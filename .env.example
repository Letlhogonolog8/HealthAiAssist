# HealthAI Assistant - Environment Configuration Template
#
# IMPORTANT: Never commit .env files to version control!
# This file shows the required variables. Copy to .env and fill in real values.
# Keep actual .env files in .gitignore at all times.

# === Database Configuration ===
# CRITICAL: Use strong password, non-admin user, and SSL connection
DATABASE_URL=postgresql://username:strong_password_here@db.example.com:5432/healthai_db

# === Authentication Configuration ===
# CRITICAL: Generate with: openssl rand -base64 32
# Change this value every time you redeploy!
SESSION_SECRET=your-256-bit-base64-encoded-random-secret-here

# === Application Environment ===
# Set to 'production' for production deployment
NODE_ENV=development
PORT=5000

# === Security Configuration ===
# Disable debug auth bypass in production ALWAYS

# Enable HTTPS in production
HTTPS_ONLY=false
PROD_ORIGIN=http://localhost:5000

# === OpenAI Configuration ===
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# === Twilio Configuration ===
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# === Google Calendar Integration ===
# Get from: https://console.cloud.google.com/
# Download service account JSON and paste entire JSON object
GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# === Notification delivery (Optional, strongly recommended) ===
# Without these, notifications exist only inside the application: a patient who
# is not looking at the tab is never told a result is ready.
#
# Messages deliberately carry NO clinical detail — email and SMS are not
# confidential channels, and a lock-screen preview naming a diagnosis discloses
# it to whoever is holding the phone. They say something is waiting and where to
# sign in.
SENDGRID_API_KEY=SG.your-sendgrid-key
NOTIFICATION_FROM_EMAIL=no-reply@your-domain.com
# Falls back to TWILIO_PHONE_NUMBER when unset.
TWILIO_SMS_NUMBER=+27000000000
# Absolute base URL used in the "sign in to view" link.
PUBLIC_APP_URL=https://your-domain.com

# === Azure/Microsoft Configuration (Optional) ===
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# === Supabase Configuration (Optional) ===
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# === Development Configuration ===
# Only use in development! Seeds initial test data
DEV_SEED=false

# === Logging Configuration ===
LOG_LEVEL=debug

# === Production hard requirements ===
# The server REFUSES to start in production without these. They are not
# warnings: a boot-time warning scrolls past in a deploy log and the deployment
# serves patients anyway.
#
# Transport encryption. Set HTTPS_ONLY=true, or TLS_TERMINATED_UPSTREAM=true if
# TLS ends at a load balancer or ingress in front of this process.
HTTPS_ONLY=true
# TLS_TERMINATED_UPSTREAM=false

# At-rest encryption for sensitive fields. Exactly 64 hex characters (32 bytes).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set ALLOW_UNENCRYPTED_AT_REST=true to proceed without it deliberately.
ENCRYPTION_KEY=
# ALLOW_UNENCRYPTED_AT_REST=false

# Prefer the keyring form once you have real data. It is what makes the key
# rotatable: ciphertext records which key produced it, so a new key can be
# introduced without stranding existing rows. ENCRYPTION_KEY above still works
# and is treated as key id "k1".
#
#   ENCRYPTION_KEYS=k1:<64 hex>,k2:<64 hex>
#   ENCRYPTION_ACTIVE_KEY_ID=k2
#
# Every listed key decrypts; only the active one encrypts.
#
# To rotate:
#   1. Add a new key under a new id, keeping the old one.
#   2. Point ENCRYPTION_ACTIVE_KEY_ID at it and restart.
#   3. npm run crypto:rotate      re-encrypts existing rows
#   4. npm run crypto:status      confirm nothing remains on the old key
#   5. Remove the old key. This step is irreversible — removing a key that
#      still has rows makes those rows permanently unreadable.
#
# npm run crypto:backfill seals rows written before encryption was switched on.
# Reads tolerate plaintext, so it can be run gradually and is safe to re-run.
# ENCRYPTION_KEYS=
# ENCRYPTION_ACTIVE_KEY_ID=

# === Object storage for scan images (Optional) ===
# Falls back to the local uploads/ directory when unset, and also when a bucket
# is configured but the upload fails. Objects are private; reads go through
# GET /api/scans/:id/image, which checks who is asking.
# GOOGLE_CLOUD_SCAN_BUCKET=healthai-medical-scans

# === CORS ===
# Same-origin is always allowed and needs no configuration. Set this only for
# genuinely separate front-end origins. Comma-separated.
# CORS_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com
