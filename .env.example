# HealthAI Assistant - Environment Configuration Template
#
# IMPORTANT: Never commit .env files to version control!
# This file shows the required variables. Copy to .env and fill in real values.
# Keep actual .env files in .gitignore at all times.

# === Database Configuration ===
# CRITICAL: Use strong password, non-admin user, and SSL connection
DATABASE_URL=postgresql://username:strong_password_here@db.example.com:5432/healthai_db

# === Authentication Configuration ===
# CRITICAL: Generate with: openssl rand -base64 32
# Change this value every time you redeploy!
SESSION_SECRET=your-256-bit-base64-encoded-random-secret-here

# === Application Environment ===
# Set to 'production' for production deployment
NODE_ENV=development
PORT=5000

# === Security Configuration ===
# Disable debug auth bypass in production ALWAYS
DEBUG_BYPASS_AUTH=false

# Enable HTTPS in production
HTTPS_ONLY=false
PROD_ORIGIN=http://localhost:5000

# === OpenAI Configuration ===
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# === Twilio Configuration ===
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# === Google Calendar Integration ===
# Get from: https://console.cloud.google.com/
# Download service account JSON and paste entire JSON object
GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# === SendGrid Configuration (Optional) ===
# Get from: https://sendgrid.com/
SENDGRID_API_KEY=SG.your-sendgrid-key

# === Azure/Microsoft Configuration (Optional) ===
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# === Supabase Configuration (Optional) ===
# Supabase project (PostgREST API credentials — public, not a DB connection).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# To run against Supabase, DATABASE_URL must be the Postgres connection string
# from Project Settings > Database — the project URL and anon key cannot connect
# to Postgres. Then: npm run db:migrate-supabase (creates schema + enables RLS).
# RLS matters: Supabase exposes public-schema tables via the anon key, which is
# public. See migrations/supabase-rls.sql.

# === Development Configuration ===
# Only use in development! Seeds initial test data
DEV_SEED=false

# === Logging Configuration ===
LOG_LEVEL=debug
