# Production Environment Variables Template
# Copy this file and set actual values for production deployment

NODE_ENV=production
PORT=5000

# Database (use cloud database URL)
DATABASE_URL=postgresql://username:password@host:port/database

# Security
SESSION_SECRET=your-super-secure-session-secret-for-production
HTTPS_ONLY=true

# OpenAI API
OPENAI_API_KEY=your-openai-api-key

# Twilio (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Google Calendar (optional)
GOOGLE_CALENDAR_CREDENTIALS=your-google-service-account-json
GOOGLE_CALENDAR_ID=your-calendar-id

# Disable debug features in production
DEBUG_BYPASS_AUTH=false

# Production origin for CORS
PROD_ORIGIN=https://your-domain.com