cookies.txt
set-openai-key.bat
*.env.production.local
inference/__pycache__/

# LIDC-IDRI working files. The annotations and manifests are redistributable
# under CC BY 3.0, but they are large and reproducible from the TCIA download,
# so the derived label table is tracked and the source folder is not.
TCIA Folder/
dataset/lidc-subset.tcia

# pytest
.pytest_cache/

# Detector training outputs. Checkpoints, experiment manifests and sample
# caches are produced by scripts/train_lung_detector.py and never committed:
# a checkpoint is identified by its SHA-256 fingerprint, recorded in the
# experiment manifest, and backed up with `npm run backup:models`, not by git.
artifacts/
training/__pycache__/
training/**/__pycache__/
*.pt
*.pth
*.ckpt
*.onnx
